{
  "schemaVersion": 1,
  "comment": "Builtin agent-delegation templates as DATA, not a hand-edited kernel TS literal (FreeBSD-audit L15). Each entry maps a vendor name to the wrapper script in THIS directory that `builtin:<name>` (or CW_AGENT_COMMAND=builtin:<name>) resolves to. Adding a vendor is a content/distribution step: drop a wrapper script here + add a line below — NO kernel edit. Still pure config: the wrapper is an out-of-process delegation script; CW never imports or calls a model API.",
  "templates": {
    "claude": "claude-p-agent.js",
    "codex": "codex-agent.js",
    "gemini": "gemini-opencode-agent.js",
    "gemini-cli": "gemini-agent.js",
    "opencode": "opencode-agent.js",
    "deepseek": "deepseek-agent.js",
    "muse": "muse-agent.js"
  },
  "versionProbe": {
    "comment": "The vendor CLI each template above runs. `cw doctor` runs `<cli> --version` once to check that it starts. A template with no entry here (deepseek: HTTP, no CLI) is not probed.",
    "clis": {
      "claude": "claude",
      "codex": "codex",
      "gemini": "opencode",
      "gemini-cli": "gemini",
      "opencode": "opencode",
      "muse": "muse"
    }
  },
  "sandbox": {
    "comment": "Used only with CW_AGENT_SANDBOX=srt (0.3.3, opt-in): per template, the hosts the vendor CLI must reach and its own state paths it writes. Data, not kernel code (policy in userland). Best effort until checked on a real login with `cw doctor --conformance`; a host missing here shows as a refused connection, and CW_AGENT_SANDBOX_HOSTS adds more. Spec: project/docs/intent/2026-11-02-agent-sandbox-srt.md.",
    "vendors": {
      "claude": {
        "hosts": [
          "api.anthropic.com",
          "*.anthropic.com",
          "claude.ai",
          "*.claude.ai"
        ],
        "write": [
          "~/.claude",
          "~/.claude.json",
          "~/.cache/claude"
        ]
      },
      "codex": {
        "hosts": [
          "api.openai.com",
          "*.openai.com",
          "chatgpt.com",
          "*.chatgpt.com"
        ],
        "write": [
          "~/.codex"
        ]
      },
      "gemini-cli": {
        "hosts": [
          "generativelanguage.googleapis.com",
          "*.googleapis.com",
          "accounts.google.com"
        ],
        "write": [
          "~/.gemini"
        ]
      },
      "gemini": {
        "hosts": [
          "opencode.ai",
          "*.opencode.ai",
          "models.dev",
          "api.deepseek.com",
          "generativelanguage.googleapis.com",
          "api.anthropic.com",
          "api.openai.com"
        ],
        "write": [
          "~/.local/share/opencode",
          "~/.local/state/opencode",
          "~/.config/opencode",
          "~/.cache/opencode"
        ]
      },
      "opencode": {
        "hosts": [
          "opencode.ai",
          "*.opencode.ai",
          "models.dev",
          "api.deepseek.com",
          "generativelanguage.googleapis.com",
          "api.anthropic.com",
          "api.openai.com"
        ],
        "write": [
          "~/.local/share/opencode",
          "~/.local/state/opencode",
          "~/.config/opencode",
          "~/.cache/opencode"
        ]
      },
      "deepseek": {
        "hosts": [
          "opencode.ai",
          "*.opencode.ai",
          "models.dev",
          "api.deepseek.com",
          "generativelanguage.googleapis.com",
          "api.anthropic.com",
          "api.openai.com"
        ],
        "write": [
          "~/.local/share/opencode",
          "~/.local/state/opencode",
          "~/.config/opencode",
          "~/.cache/opencode"
        ]
      },
      "muse": {
        "hosts": [],
        "write": [
          "~/.muse"
        ]
      }
    }
  }
}
