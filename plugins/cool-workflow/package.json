{
  "name": "cool-workflow",
  "version": "0.3.3",
  "bin": {
    "cool-workflow": "scripts/cw.js",
    "cw": "scripts/cw.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coo1white/cool-workflow.git",
    "directory": "plugins/cool-workflow"
  },
  "homepage": "https://github.com/coo1white/cool-workflow#readme",
  "bugs": {
    "url": "https://github.com/coo1white/cool-workflow/issues"
  },
  "description": "A workflow control plane and run-time you are able to check: it sends out jobs in TypeScript, makes certain of work against facts before it goes through, puts state into fixed records, orders jobs by time, runs jobs again and again, gets a group of agents to do their parts together, and talks MCP. It gives the doing of the work to outside agents — it never runs the models itself.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.4.1",
  "license": "BSD-2-Clause",
  "author": {
    "name": "COOLWHITE LLC"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".gemini-plugin/",
    ".opencode-plugin/",
    ".mcp.json",
    "manifest/",
    "README.md",
    "apps/",
    "dist/",
    "docs/",
    "scripts/",
    "skills/",
    "ui/",
    "workflows/",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "node scripts/build-ui.mjs",
    "prepack": "npm run build:ui",
    "check": "tsc -p tsconfig.json --noEmit",
    "dist:check": "node scripts/dist-drift-check.mjs",
    "purity:check": "node scripts/purity-gate.mjs",
    "lang:check": "node scripts/lang-policy-check.mjs",
    "golden-path": "node scripts/golden-path.mjs",
    "dogfood:release": "node scripts/dogfood-release.mjs",
    "canonical-apps": "node scripts/canonical-apps.mjs",
    "fixture-compat": "node test/run-fixture-compat-smoke.mjs",
    "sync:project-index": "node scripts/sync-project-index.mjs",
    "index:check": "node scripts/sync-project-index.mjs --check",
    "sync:readme": "node scripts/sync-readme.mjs",
    "readme:check": "node scripts/sync-readme.mjs --check",
    "citation:check": "node scripts/citation-check.mjs",
    "growth:check": "node scripts/growth-budget-check.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "new:feature": "node scripts/new-feature.mjs",
    "forward-ref": "node scripts/forward-ref-docs.mjs",
    "gen:manifests": "node scripts/gen-manifests.mjs",
    "gen:parity": "node scripts/gen-parity-doc.mjs",
    "manifest:load-check": "node test/vendor-manifest-load-smoke.mjs",
    "parity:check": "node scripts/parity-check.mjs --check",
    "onramp:check": "node scripts/onramp-check.mjs --check",
    "version:sync": "node scripts/version-sync-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release": "node scripts/release-oneclick.mjs",
    "release:doctor": "node scripts/release-doctor.mjs",
    "test": "node dist/cli.js version > /dev/null && node test/run-all.mjs --fast --sample 35",
    "test:full": "node dist/cli.js version > /dev/null && node test/run-all.mjs --sample 55",
    "test:gate": "node dist/cli.js version > /dev/null && node test/run-all.mjs",
    "test:fast": "npm run build --if-present && node dist/cli.js version > /dev/null && node test/run-all.mjs --concurrency auto",
    "test:ci": "npm run build && node dist/cli.js version > /dev/null && node test/run-all.mjs --sample 55",
    "test:coverage": "node dist/cli.js version > /dev/null && node scripts/coverage-gate.mjs --concurrency auto",
    "test:unit": "node dist/cli.js version > /dev/null && node test/run-unit.mjs",
    "ci": "npm run build && npm run check && npm run test && npm run release:check",
    "validate:schema": "node scripts/validate-run-state-schema.mjs",
    "bench:workbench:deep": "node scripts/bench/workbench-load.mjs",
    "build:css": "node scripts/build-css.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^26.4.0",
    "daisyui": "5.7.42",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  },
  "keywords": [
    "agent",
    "workflow",
    "control-plane",
    "mcp",
    "multi-agent",
    "orchestration",
    "audit",
    "llm-pipeline",
    "claude",
    "delegation"
  ],
  "mcpName": "io.github.coo1white/cool-workflow"
}
