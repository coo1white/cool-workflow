{
  "_comment": "SINGLE SOURCE OF TRUTH for every vendor manifest. Edit THIS file, then run `npm run gen:manifests`. Do NOT hand-edit the generated vendor manifests (.claude-plugin/, .codex-plugin/, .agents/) — `npm run gen:manifests -- --check` (run by release:check) will fail if they drift from this source.",
  "identity": {
    "name": "cool-workflow",
    "version": "0.5.0",
    "license": "BSD-2-Clause",
    "homepage": "https://github.com/coo1white/cool-workflow",
    "author": {
      "name": "COOLWHITE LLC"
    },
    "keywords": [
      "workflow",
      "control-plane",
      "dynamic-workflows",
      "subagents",
      "orchestration",
      "agents",
      "multi-agent",
      "receipts",
      "evidence"
    ]
  },
  "descriptions": {
    "short": "Receipts for AI work you can check.",
    "standard": "Keeps the books for AI work: an outside agent does the work, CW records each claim with the lines it rests on, gates the result on evidence, and writes a report you can verify offline. It never runs a model itself.",
    "long": "Cool Workflow (CW) keeps the books for AI work. Ask a question with cw -q; CW plans the review, hands each step to an outside agent CLI, accepts only results whose evidence resolves to real lines, commits the run, and writes report.md and report.html. cw check keeps a receipt that a command passed; cw report bundle seals a run into one file that cw report verify-bundle checks offline and fails closed. CW never runs a model, never holds a key, and never uploads code."
  },
  "interface": {
    "displayName": "Cool Workflow",
    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Read",
      "Write"
    ],
    "brandColor": "#2563EB",
    "defaultPrompt": [
      "Use Cool Workflow to plan this as phases and agents.",
      "Run the architecture review workflow with CW.",
      "Create a reusable CW workflow for this task."
    ]
  },
  "layout": {
    "pluginPathFromRepoRoot": "./plugins/cool-workflow",
    "skillsDir": "./skills/"
  },
  "targets": {
    "claude": {
      "marketplace": ".claude-plugin/marketplace.json",
      "plugin": "plugins/cool-workflow/.claude-plugin/plugin.json",
      "pluginRootVar": "${CLAUDE_PLUGIN_ROOT}/"
    },
    "codex": {
      "marketplace": ".agents/plugins/marketplace.json",
      "plugin": "plugins/cool-workflow/.codex-plugin/plugin.json",
      "pluginRootVar": "./"
    },
    "agents": {
      "plugin": ".agents/plugins/cool-workflow/plugin.json",
      "pluginRootVar": "./"
    },
    "gemini": {
      "plugin": "plugins/cool-workflow/.gemini-plugin/plugin.json",
      "pluginRootVar": "./"
    },
    "opencode": {
      "plugin": "plugins/cool-workflow/.opencode-plugin/plugin.json",
      "pluginRootVar": "./"
    }
  },
  "_comment_vendors": "VENDOR ADAPTER REGISTRY (v0.1.47). Each vendor declares its outputs as templates over the source fields above. Adding a new AI platform: add ONE entry here — no gen-manifests.mjs changes needed. Templates use {{path.to.field}} interpolation; {{pluginRootVar}} resolves to the vendor's pluginRootVar.",
  "vendors": {
    "claude": {
      "outputs": [
        {
          "path": "{{targets.claude.marketplace}}",
          "json": {
            "name": "{{identity.name}}",
            "owner": "{{identity.author}}",
            "metadata": {
              "description": "{{descriptions.standard}}",
              "version": "{{identity.version}}"
            },
            "plugins": [
              {
                "name": "{{identity.name}}",
                "source": "{{layout.pluginPathFromRepoRoot}}",
                "description": "{{descriptions.standard}}",
                "category": "{{interface.category|lowercase}}"
              }
            ]
          }
        },
        {
          "path": "{{targets.claude.plugin}}",
          "json": {
            "name": "{{identity.name}}",
            "description": "{{descriptions.standard}}",
            "version": "{{identity.version}}",
            "author": "{{identity.author}}",
            "homepage": "{{identity.homepage}}",
            "license": "{{identity.license}}",
            "keywords": "{{identity.keywords}}"
          }
        }
      ]
    },
    "codex": {
      "outputs": [
        {
          "path": "{{targets.codex.marketplace}}",
          "json": {
            "name": "{{identity.name}}",
            "interface": {
              "displayName": "{{interface.displayName}}"
            },
            "plugins": [
              {
                "name": "{{identity.name}}",
                "source": {
                  "source": "local",
                  "path": "{{layout.pluginPathFromRepoRoot}}"
                },
                "policy": {
                  "installation": "AVAILABLE",
                  "authentication": "ON_INSTALL"
                },
                "category": "{{interface.category}}"
              }
            ]
          }
        },
        {
          "path": "{{targets.codex.plugin}}",
          "json": {
            "name": "{{identity.name}}",
            "version": "{{identity.version}}",
            "description": "{{descriptions.standard}}",
            "author": "{{identity.author}}",
            "keywords": "{{identity.keywords}}",
            "skills": "{{layout.skillsDir}}",
            "interface": {
              "displayName": "{{interface.displayName}}",
              "shortDescription": "{{descriptions.short}}",
              "longDescription": "{{descriptions.long}}",
              "developerName": "{{identity.author.name}}",
              "category": "{{interface.category}}",
              "capabilities": "{{interface.capabilities}}",
              "brandColor": "{{interface.brandColor}}",
              "defaultPrompt": "{{interface.defaultPrompt}}"
            }
          }
        }
      ]
    },
    "agents": {
