# GitHub Linguist: keep the Languages bar to JS/TS. These files are needed
# and cannot be JS (a Homebrew formula must be Ruby; the workbench UI serves
# its html/css from disk by design) -- this excludes them from the language
# STATS only, nothing about their behavior changes.
Formula/** linguist-vendored
plugins/cool-workflow/ui/workbench/*.css linguist-documentation
plugins/cool-workflow/ui/workbench/*.html linguist-documentation
# `.sig` files here are base64 ed25519 signature blobs (verify-verdict-signature.js's
# sidecars), NOT Standard ML source -- Linguist maps the bare `.sig` extension to
# that language by file-extension heuristic alone, with no content check.
.cw-release/*.sig linguist-generated

